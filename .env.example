# Required
ANTHROPIC_API_KEY=sk-ant-...
APP_PASSWORD=

# Optional — Telegram send-only weekly push
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Postgres (Railway sets this); blank = local SQLite
DATABASE_URL=

# Path to the local SQLite file when DATABASE_URL is blank.
DATABASE_PATH=./weekly_updates.db

# Discrete Postgres connection vars. Normally supplied by the platform — set
# them only if you need to override what DATABASE_URL resolves to. pg_dump
# prefers these when present (jobs/backup_db.py), which avoids re-parsing a URL
# whose password may be percent-encoded.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=

# Google OAuth2 (Calendar + Gmail; token must carry BOTH scopes — run scripts/calendar_auth.py)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional tuning
TIMEZONE=America/Denver
GMAIL_SCAN_INTERVAL_HOURS=4
GMAIL_SCAN_LOOKBACK_DAYS=7
CALENDAR_SCAN_HOUR=6
WEEKLY_PUSH_HOUR=9

# Session lifetime. TTL renews slidingly past the halfway point; MAX is the
# absolute cap that stops an active (or stolen) cookie renewing forever.
SESSION_TTL_DAYS=14
SESSION_MAX_DAYS=60

# Off-Railway destination for the daily pg_dump (jobs/backup_db.py).
# All four unset = backups no-op with a logged warning. Any S3-compatible
# store works; endpoint must include the scheme.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_HOUR=4
# Fernet key encrypting the dump before upload. Unset = uploads unencrypted
# with a logged warning (a backup gap is worse than an unencrypted backup).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this somewhere OTHER than Railway too, or a Railway-side loss takes
# every encrypted backup down with it.
BACKUP_ENCRYPTION_KEY=

# Bank ingestion (SimpleFIN). The access URL *is* the credential — it carries
# its own auth inline, so treat it like a password and never log it.
# Unset = bank sync no-ops cleanly.
SIMPLEFIN_ACCESS_URL=
SIMPLEFIN_SYNC_INTERVAL_HOURS=12
# 90 is SimpleFIN's hard cap — anything older is unrecoverable.
SIMPLEFIN_LOOKBACK_DAYS=90
# Max days between the two halves of a matched transfer.
PAIR_WINDOW_DAYS=3
# Comma-separated payroll signatures. Only matching unpaired deposits count as
# income; blank means no deposit is ever classified as income.
INCOME_PAYEE_HINTS=

# Optional usage accounting endpoint; both unset disables reporting.
COACH_USAGE_URL=
COACH_USAGE_TOKEN=
